---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="https://fav.farm/📸" />
    <title>BeReal Memories</title>
  </head>
  <body class="dark flex min-h-screen flex-col bg-neutral-950 text-white">
    <div class="py-3 text-center">
      <h1 class="text-3xl font-bold mb-1">BeReal Memories 📸</h1>
      <p class="text-sm text-gray-300">
        A tool which allows you to view and export your BeReals.
      </p>
    </div>
    <main class="grow px-5">
      <slot />
    </main>
    <footer class="my-3">
      <p class="text-center text-sm text-gray-300">
        v{__APP_VERSION__} •{" "}
        <a href="https://github.com/vascYT/bereal-memories" target="_blank">
          Source
        </a>
        <br />
        Made with 💖 by <a href="https://vasc.dev">vasc</a>
      </p>
    </footer>
  </body>
</html>
